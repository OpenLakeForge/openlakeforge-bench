@@ -0,0 +1,19 @@
+"""Benchmark-only: apply OpenLakeForge/floe#1211 to the installed dagster-floe 0.5.0.
+
+A finished run's Floe output becomes one Dagster log event instead of one per line.
+"""
+
+import importlib.util
+from pathlib import Path
+
+spec = importlib.util.find_spec("floe_dagster")
+assert spec and spec.submodule_search_locations
+path = Path(next(iter(spec.submodule_search_locations))) / "assets.py"
+source = path.read_text()
+old_head = "        for event in events\n    }\n    for line in stdout.splitlines():"
+new_head = "        for event in events\n    }\n    lines: list[str] = []\n    for line in stdout.splitlines():"
+old_tail = '        context.log.info(rendered or f"floe stdout | {stripped}")'
+new_tail = '        lines.append(rendered or f"floe stdout | {stripped}")\n    if lines:\n        context.log.info("\\n".join(lines))'
+assert source.count(old_head) == 1 and source.count(old_tail) == 1, "dagster-floe assets.py is not the 0.5.0 shape"
+path.write_text(source.replace(old_head, new_head).replace(old_tail, new_tail))
+print(f"patched {path}")
